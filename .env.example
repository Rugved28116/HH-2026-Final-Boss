# Neither of these is required for the core photo -> graphic -> download path.
# That pipeline is entirely client-side (see docs/schema.md §9), so `npm run dev`
# and `npm run build` must both work with this file absent.

# --- Share upload (/api/share, Phase 5) ---
# Vercel Blob read/write token. Without it, Share falls back to a direct
# download (docs/app-flow.md §6).
BLOB_READ_WRITE_TOKEN=

# --- Live frames-created counter (/api/counter*, Phase 6 / D4) ---
# Single key "hhgoa2026:frames_created" (docs/schema.md §7).
# Vercel KV is deprecated upstream and now provisions as Upstash Redis; these
# are the variable names the Upstash marketplace integration injects.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- QR code target (D3) ---
# Baked into the Builder ID card at render time (docs/schema.md §6). Set this
# to the deployed origin; falls back to a placeholder URL when unset.
NEXT_PUBLIC_SITE_URL=
